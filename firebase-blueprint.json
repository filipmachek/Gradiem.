{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile state and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSyncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "UserAppState": {
      "title": "UserAppState",
      "description": "Full synchronized app state for the user (tasks, streak, earned facts, custom topics)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "tasks": { "type": "string", "maxLength": 100000 },
        "streak": { "type": "string", "maxLength": 10000 },
        "earnedFacts": { "type": "string", "maxLength": 100000 },
        "savedTopics": { "type": "string", "maxLength": 10000 },
        "theme": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "tasks", "streak"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile information"
    },
    "/userData/{userId}": {
      "schema": "UserAppState",
      "description": "User's synchronized personal habit tracking state"
    }
  }
}
